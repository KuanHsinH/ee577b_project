
#
# Preferences
#
preferences set plugin-enable-svdatabrowser-new 1
preferences set plugin-enable-groupscope 0
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0

#
# Databases
#
database require waves -search {
	./waves.shm/waves-5.trn
	/home/klin7311@vlab.usc.edu/ee577b/NoC_mesh_project/phase0_NoC_router/ee577b_project/waves.shm/waves-5.trn
}

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 730x500+1048+422}] != ""} {
    window geometry "Design Browser 1" 730x500+1048+422
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set \
    -signalsort name
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "NIC" -geometry 1391x841+219+72}] != ""} {
    window geometry "NIC" 1391x841+219+72
}
window target "NIC" on
waveform using NIC
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 175 \
    -units ns \
    -valuewidth 75
waveform baseline set -time 0

set id [waveform add -signals  {
	simulator::tb_cardinal_nic.clk
	} ]
set id [waveform add -signals  {
	simulator::tb_cardinal_nic.reset
	} ]
set id [waveform add -signals  {
	{simulator::tb_cardinal_nic.addr[1:0]}
	} ]
set id [waveform add -signals  {
	simulator::tb_cardinal_nic.nicEn
	} ]
set id [waveform add -signals  {
	simulator::tb_cardinal_nic.nicEnWr
	} ]
set id [waveform add -signals  {
	{simulator::tb_cardinal_nic.d_in[63:0]}
	} ]
set id [waveform add -signals  {
	{simulator::tb_cardinal_nic.d_out[63:0]}
	} ]
set id [waveform add -signals  {
	simulator::tb_cardinal_nic.net_si
	} ]
set id [waveform add -signals  {
	simulator::tb_cardinal_nic.net_ri
	} ]
set id [waveform add -signals  {
	{simulator::tb_cardinal_nic.net_di[63:0]}
	} ]
set id [waveform add -signals  {
	simulator::tb_cardinal_nic.net_so
	} ]
set id [waveform add -signals  {
	simulator::tb_cardinal_nic.net_ro
	} ]
set id [waveform add -signals  {
	{simulator::tb_cardinal_nic.net_do[63:0]}
	} ]
set id [waveform add -signals  {
	simulator::tb_cardinal_nic.net_polarity
	} ]
set id [waveform add -signals  {
	simulator::tb_cardinal_nic.dut.in_full
	} ]
set id [waveform add -signals  {
	simulator::tb_cardinal_nic.dut.out_full
	} ]
set id [waveform add -signals  {
	{simulator::tb_cardinal_nic.dut.in_buf[63:0]}
	} ]
set id [waveform add -signals  {
	{simulator::tb_cardinal_nic.dut.out_buf[63:0]}
	} ]

waveform xview limits 31.29ns 41.29ns

#
# Waveform Window Links
#

#
# Console windows
#
console set -windowname Console
window geometry Console 730x422+833+441

